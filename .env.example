# puzzpool environment configuration
# Copy to .env and adjust for your deployment.
# The server auto-loads .env from the working directory on startup.
# Variables already set in the process environment take precedence.

# Port the Crow server binds to (127.0.0.1 only, behind Nginx)
PORT=8888

# SQLite database file path (relative to working directory, or absolute)
DB_PATH=pool.db

# Minutes a chunk should take to scan (used to size chunks per worker's hashrate)
TARGET_MINUTES=10

# Minutes before an unfinished chunk is reclaimed and reissued
TIMEOUT_MINUTES=15

# Minutes a worker stays green (active) after its last heartbeat/work call.
# Accepts fractional values. Default matches the client's 30 s heartbeat with margin:
# 70 s ≈ 1.167 min — worker goes gray ~40 s after a missed heartbeat.
# Automatically capped at half of TIMEOUT_MINUTES so the gray phase is always visible.
ACTIVE_MINUTES=1.167

# Maximum number of sectors the keyspace is divided into (must be a positive integer).
# More sectors = finer spatial spread but slower ORDER BY RANDOM() sector selection.
# Benchmark /api/v1/work under load before raising significantly above the default.
TARGET_SECTORS=65536

# Deployment stage — shown in dashboard and used to tint the favicon.
# Use PROD for production, TEST for the test instance.
STAGE=PROD

# ── Admin authentication ──────────────────────────────────────────────────────
# Admin routes fail closed. If NEITHER ADMIN_TOKEN NOR ADMIN_GITHUB_USERS is
# configured, every /api/v1/admin/* route returns 401 — a blank value does not
# disable authentication, it denies everybody. Configure at least one mechanism.

# Admin API token — if set, all /api/v1/admin/* routes accept the header:
#   X-Admin-Token: <value>
# Generate with:  openssl rand -hex 32
ADMIN_TOKEN=

# Comma-separated GitHub logins allowed to administer the pool. Matching is
# case-insensitive and surrounding whitespace is ignored. The list is re-read on
# every admin request, so removing a login revokes access immediately.
# An empty list grants nobody access.
# Example: ADMIN_GITHUB_USERS=alice,bob
ADMIN_GITHUB_USERS=

# ── GitHub OAuth sign-in ──────────────────────────────────────────────────────
# PROD and TEST run SEPARATE GitHub OAuth applications with separate callback
# URLs. Supply only the credentials belonging to THIS deployment stage; never
# put both stages' credentials in one environment.
# Register an app at: https://github.com/settings/developers
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional. When empty, GitHub uses the callback URL registered on the OAuth
# app. Set it explicitly if the app registers more than one.
# Example: GITHUB_OAUTH_CALLBACK_URL=https://puzzle.b58.de/api/v1/auth/github/callback
GITHUB_OAUTH_CALLBACK_URL=

# Key used to sign the session cookie (HMAC-SHA-256). Must be distinct from
# ADMIN_TOKEN and from any allocator seed.
# Generate with:  openssl rand -hex 32
# If unset or empty the OAuth/cookie path is disabled: /api/v1/auth/* returns
# 503 and no session cookie is issued or accepted. There is no default key.
SESSION_SIGNING_SECRET=

# Lifetime of an issued session cookie, in minutes. Default 720 = 12 hours.
SESSION_TTL_MINUTES=720

# External explorer endpoint used to check whether an address-backed puzzle
# has already been solved by an external third party.
BLOCKEXPLORER_API=https://mempool.space/api/address/

# Public explorer URL used for the solved/unsolved badge link in the dashboard.
BLOCKEXPLORER_URL=https://mempool.space/address/

# Seconds between backend refreshes of cached puzzle solved-state metadata.
# Address lookups use BLOCKEXPLORER_API. Threshold targets (for example ALL BTC)
# are recomputed from local findings on the same schedule.
BLOCKEXPLORER_POLL_SEC=600

# ── Build-time variables (no effect at server runtime) ────────────────────────

# Number of parallel C++ compile jobs. Default 1 to keep peak RAM low on
# memory-constrained hosts. Each Crow/Boost-heavy translation unit can spike to
# 300–500 MB; running several in parallel quickly exhausts RAM on a shared server.
# Raise only if you have measured headroom (e.g. BUILD_JOBS=2 on a 4 GB host
# with no other heavy processes running).
BUILD_JOBS=1

# Set to ON if the system has libsqlite3-dev installed. Avoids compiling
# SQLiteCpp from source, saving ~50 MB peak RAM and build time.
# Install with: sudo apt-get install -y libsqlite3-dev
PUZZPOOL_USE_SYSTEM_SQLITECPP=OFF

# Supply-chain guard: minimum age (in minutes) a Node.js release must have before
# it is used during the frontend build step (scripts/check-node-version-age.sh).
# Default 1440 = 24 hours. Set to 0 to disable (not recommended in production).
MINIMUM_NODE_RELEASE_AGE=1440

# Keyspace definitions — any number of KEYSPACE_<NAME>=<start_hex>:<end_hex> entries.
# NAME (underscores replaced with spaces) becomes the puzzle name in the dashboard.
# On startup, missing puzzles are seeded automatically (inactive by default).
# The first puzzle in the DB is activated if none is currently active.
#
# Example:
# KEYSPACE_PUZZLE_71=0x0400000000000000000:0x07fffffffffffffffff
# KEYSPACE_ALL_BTC=0x1:0xfffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141
#
# Optional solved-state targets for dashboard badges:
# - address-backed puzzles: PUZZLE_<NAME>_TARGET=<bitcoin_address>
# - ALL BTC threshold puzzle: PUZZLE_ALL_BTC_TARGET=<distinct_found_key_threshold>
#
# Examples:
# PUZZLE_71_TARGET=1PWo3JeB9jrGwfHDNpdGK54CRas7fsVzXU
# PUZZLE_ALL_BTC_TARGET=5
